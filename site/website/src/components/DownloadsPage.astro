---
import '../../../../packages/beskid-docs-ui/src/styles/downloads.css';
import { loadCliVersion, loadVscodeExtensionVersion } from '../lib/load-download-versions';

export interface Props {
	version?: string;
	versionSource?: string;
	vscodeVersion?: string;
	vscodeVersionSource?: string;
}

const cli = loadCliVersion();
const vscode = loadVscodeExtensionVersion();

const version = Astro.props.version ?? cli.version;
const versionSource = Astro.props.versionSource ?? cli.source;
const vscodeVersion = Astro.props.vscodeVersion ?? vscode.version;
const vscodeVersionSource = Astro.props.vscodeVersionSource ?? vscode.source;

const releaseBase =
	'https://github.com/Cyber-Nomad-Collective/beskid_compiler/releases/download/cli-latest';
const channelLabel = versionSource === 'github' ? 'cli-latest' : versionSource;
const vscodeChannelLabel = vscodeVersionSource === 'open-vsx' ? 'Open VSX' : vscodeVersionSource;
const installSh = 'curl -fsSL https://beskid-lang.org/install.sh | bash';
const installPs = 'iwr https://beskid-lang.org/install.ps1 -useb | iex';
const openVsxUrl = 'https://open-vsx.org/extension/beskid/beskid-vscode';
const vscodeInstallCmd = 'code --install-extension beskid.beskid-vscode';

const platforms = [
	{ id: 'linux-amd64', short: 'Linux', label: 'Linux (x86_64)', asset: 'beskid-linux-amd64', command: installSh, script: 'install.sh' },
	{
		id: 'darwin-arm64',
		short: 'macOS',
		label: 'macOS (Apple Silicon)',
		asset: 'beskid-darwin-arm64',
		command: installSh,
		script: 'install.sh',
	},
	{
		id: 'windows-amd64',
		short: 'Windows',
		label: 'Windows (x86_64)',
		asset: 'beskid-windows-amd64.exe',
		command: installPs,
		script: 'install.ps1',
	},
] as const;
---

<section
	class="downloads-page not-content"
	data-downloads-page
	data-cli-version={version}
	data-release-base={releaseBase}
>
	<div class="downloads-layout">
		<section class="downloads-block">
			<header class="downloads-block__header">
				<h1 class="downloads-title">Beskid CLI</h1>
				<p class="downloads-meta">
					<span class="downloads-meta__version">{version}</span>
					<span class="downloads-meta__sep" aria-hidden="true">·</span>
					<span class="downloads-meta__channel">{channelLabel}</span>
				</p>
			</header>

			<div class="downloads-tabs" data-install-tabs role="tablist" aria-label="Platform">
				{
					platforms.map((platform) => (
						<button
							type="button"
							class="downloads-tab"
							data-install-tab
							data-platform={platform.id}
							role="tab"
							aria-selected="false"
						>
							{platform.short}
						</button>
					))
				}
			</div>

			<div class="downloads-command">
				<div class="downloads-command__row">
					<span class="downloads-command__label" data-command-label>install.sh</span>
					<button
						type="button"
						class="downloads-command__copy"
						data-copy-install
						aria-label="Copy install command"
					>
						<span data-copy-label>Copy</span>
					</button>
				</div>
				<pre class="downloads-command__pre"><code data-install-command>{installSh}</code></pre>
			</div>

			<div class="downloads-actions">
				<a
					class="downloads-btn downloads-btn--primary"
					data-direct-download
					href={`${releaseBase}/beskid-linux-amd64`}
					download="beskid-linux-amd64"
				>
					<span data-direct-download-label>Download binary</span>
				</a>
				<a
					class="downloads-btn downloads-btn--secondary"
					href="https://github.com/Cyber-Nomad-Collective/beskid_compiler/releases/tag/cli-latest"
					rel="noopener noreferrer"
				>
					GitHub releases
				</a>
			</div>

			<p class="downloads-hint" data-platform-hint hidden></p>

			<details class="downloads-more">
				<summary>All platform binaries</summary>
				<ul class="downloads-platform-rows">
					{
						platforms.map((platform) => (
							<li class="downloads-platform-row">
								<div class="downloads-platform-row__main">
									<span class="downloads-platform-row__label">{platform.label}</span>
									<code class="downloads-platform-row__cmd">{platform.command}</code>
								</div>
								<a
									class="downloads-btn downloads-btn--secondary downloads-btn--compact"
									href={`${releaseBase}/${platform.asset}`}
									download={platform.asset}
								>
									Download
								</a>
							</li>
						))
					}
				</ul>
			</details>
		</section>

		<section class="downloads-block">
			<header class="downloads-block__header">
				<h2 class="downloads-title downloads-title--section">VS Code extension</h2>
				<p class="downloads-lead">
					Language support, bundled LSP, and workspace tooling for VS Code and compatible editors.
				</p>
				<p class="downloads-meta">
					<span class="downloads-meta__version">{vscodeVersion}</span>
					<span class="downloads-meta__sep" aria-hidden="true">·</span>
					<span class="downloads-meta__channel">{vscodeChannelLabel}</span>
				</p>
			</header>

			<div class="downloads-command">
				<div class="downloads-command__row">
					<span class="downloads-command__label">CLI install</span>
					<button
						type="button"
						class="downloads-command__copy"
						data-copy-vscode
						aria-label="Copy VS Code install command"
					>
						<span data-copy-vscode-label>Copy</span>
					</button>
				</div>
				<pre class="downloads-command__pre"><code>{vscodeInstallCmd}</code></pre>
			</div>

			<div class="downloads-actions">
				<a class="downloads-btn downloads-btn--primary" href={openVsxUrl} rel="noopener noreferrer">
					Install from Open VSX
				</a>
				<a class="downloads-btn downloads-btn--secondary" href="/platform-spec/tooling/vscode-extension/">
					Extension docs
				</a>
			</div>
		</section>

		<p class="downloads-footnote">
			CLI installs to <code>~/.beskid/bin/beskid</code> (macOS/Linux) or
			<code>%USERPROFILE%\.beskid\bin\beskid.exe</code> (Windows).
		</p>
	</div>
</section>

<script>
	import '../../../../packages/beskid-docs-ui/src/client/downloads-client.ts';
</script>
