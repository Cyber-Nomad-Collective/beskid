---
import { DownloadsSection, type PinnedDownloadRelease, type PlatformId } from "@beskid/ui-react/downloads";

const version = "0.7.0";
const tag = `v${version}`;
const releasesUrl = "https://github.com/Cyber-Nomad-Collective/beskid_compiler/releases";
const assetsUrl = `${releasesUrl}/download/${tag}`;

function downloadForPlatform(build: {
	platform: PlatformId;
	target: string;
	editor: string;
	packageFilename: string;
	packageLabel: string;
	packageCommand: string;
}) {
	const directory = `beskid-${version}-${build.target}`;
	const filename = `${directory}.tar.gz`;
	const url = `${assetsUrl}/${filename}`;
	const editorFilename = `beskid-vscode-${version}-${build.editor}.vsix`;
	const isWindows = build.platform === "windows-amd64";
	return {
		asset: { platform: build.platform, kind: "binary" as const, filename, url },
		package: {
			platform: build.platform,
			label: build.packageLabel,
			command: build.packageCommand,
			url: `${assetsUrl}/${build.packageFilename}`,
		},
		install: {
			installCommand: isWindows
				? `curl.exe -fLO "${url}"\nif ($LASTEXITCODE -eq 0) { tar.exe -xzf "${filename}" }`
				: `curl -fLO "${url}" && tar -xzf "${filename}"`,
			installLocation: isWindows ? `.\\${directory}\\bin\\beskid.exe` : `./${directory}/bin/beskid`,
			editor: { filename: editorFilename, url: `${assetsUrl}/${editorFilename}` },
		},
	};
}

const linux = downloadForPlatform({
	platform: "linux-amd64",
	target: "x86_64-unknown-linux-gnu",
	editor: "linux-x64",
	packageFilename: `beskid-${version}-amd64.deb`,
	packageLabel: "Ubuntu / Debian (.deb)",
	packageCommand: `sudo apt install ./beskid-${version}-amd64.deb`,
});
const macos = downloadForPlatform({
	platform: "darwin-arm64",
	target: "aarch64-apple-darwin",
	editor: "darwin-arm64",
	packageFilename: `beskid-${version}-macos-arm64.dmg`,
	packageLabel: "macOS (.dmg)",
	packageCommand: "Open the disk image and drag Beskid.app to Applications",
});
const windows = downloadForPlatform({
	platform: "windows-amd64",
	target: "x86_64-pc-windows-msvc",
	editor: "win32-x64",
	packageFilename: `beskid-${version}-windows-amd64.msi`,
	packageLabel: "Windows (.msi)",
	packageCommand: `msiexec /i beskid-${version}-windows-amd64.msi`,
});

const pinnedRelease: PinnedDownloadRelease = {
	version,
	tag,
	source: "github:stable",
	url: `${releasesUrl}/tag/${tag}`,
	checksumsUrl: `${assetsUrl}/SHA256SUMS`,
	assets: [linux.asset, macos.asset, windows.asset],
	packages: [linux.package, macos.package, windows.package],
	platforms: {
		"linux-amd64": linux.install,
		"darwin-arm64": macos.install,
		"windows-amd64": windows.install,
	},
};
---

<div class="downloads-page">
	<div class="downloads-layout">
		<DownloadsSection client:only="react" pinnedRelease={pinnedRelease} />
	</div>
</div>
