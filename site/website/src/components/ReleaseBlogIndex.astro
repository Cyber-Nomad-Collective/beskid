---
import { getCollection } from 'astro:content';
import { sortBlogEntries, type BlogStatus } from '../lib/blog';
import { BlogPostCard } from './blog/BlogPostCard.tsx';

const entries =
	(await getCollection('docs')).filter(
		(entry): entry is typeof entry & { data: typeof entry.data & { blogStatus: BlogStatus; date: Date } } =>
			entry.id.startsWith('blog/') && entry.data.blogStatus !== undefined && entry.data.date !== undefined,
	);
const [featured, ...archive] = sortBlogEntries(entries);

const dateFormatter = new Intl.DateTimeFormat('en', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
});

const BLOG_IMAGES = {
	mountain: {
		src: 'https://commons.wikimedia.org/wiki/Special:FilePath/G%C5%82owacki%20Mountain%20landscape.jpg?width=1200',
		alt: 'Public-domain Polish mountain landscape painting.',
		sourceHref: 'https://commons.wikimedia.org/wiki/File:G%C5%82owacki_Mountain_landscape.jpg',
		sourceLabel: 'Głowacki, public domain',
	},
	terminal: {
		src: 'https://commons.wikimedia.org/wiki/Special:FilePath/COMPUTER%20TERMINAL%20-%20NARA%20-%2017500667.jpg?width=1200',
		alt: 'Historic computer terminal.',
		sourceHref: 'https://commons.wikimedia.org/wiki/File:COMPUTER_TERMINAL_-_NARA_-_17500667.jpg',
		sourceLabel: 'NASA/NARA, public domain',
	},
};

function imageFor(id: string) {
	return /compiler|runtime|tooling|infra/.test(id) ? BLOG_IMAGES.terminal : BLOG_IMAGES.mountain;
}
---

<section class="blog" aria-label="Blog">
	<header class="blog__intro">
		<p class="blog__eyebrow">Blog</p>
		<h1>The work behind Beskid</h1>
	</header>

	{featured && (
		<article class="blog__feature">
			<img src={imageFor(featured.id).src} alt={imageFor(featured.id).alt} />
			<div class="blog__feature-copy">
				<div class="blog__meta">
					<time datetime={featured.data.date.toISOString()}>{dateFormatter.format(featured.data.date)}</time>
					{featured.data.release && <span>{featured.data.release}</span>}
				</div>
				<h2><a href={`/${featured.id}/`}>{featured.data.title}</a></h2>
				<p>{featured.data.description}</p>
				<a class="blog__read" href={`/${featured.id}/`}>Read the post <span aria-hidden="true">→</span></a>
			</div>
		</article>
	)}

	<section class="blog__archive" aria-labelledby="blog-archive-title">
		<div class="blog__archive-heading">
			<div>
				<p class="blog__eyebrow">From the archive</p>
				<h2 id="blog-archive-title">Older notes</h2>
			</div>
		</div>
		<ol class="blog__list">
		{archive.map((entry) => (
			<li class="blog__item">
				<BlogPostCard title={entry.data.title} description={entry.data.description} href={`/${entry.id}/`} date={dateFormatter.format(entry.data.date)} dateTime={entry.data.date.toISOString()} release={entry.data.release} image={imageFor(entry.id)} />
			</li>
		))}
		</ol>
	</section>
</section>

<style>
	:global(.page:has(.blog) nav.sidebar), :global(.page:has(.blog) .right-sidebar-container) { display: none; }
	:global(.page:has(.blog) .main-frame) { grid-template-columns: 1fr; }
	:global(.page:has(.blog) .main-pane) { width: 100%; margin-inline: auto; max-width: 78rem; }
	:global(.page:has(.blog) .content-panel .sl-container) { max-width: 78rem; }
	.blog { max-width: 70rem; margin: 3.5rem auto 5rem; padding-inline: clamp(1rem, 4vw, 3rem); }
	.blog__intro { max-width: 48rem; margin-bottom: 2.5rem; color: var(--sl-color-gray-3); font-size: var(--sl-text-lg); }
	.blog__eyebrow { margin-bottom: .5rem; color: var(--sl-color-text-accent); font-size: var(--sl-text-sm); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
	.blog__intro h1, .blog__archive h2 { margin: 0; color: var(--sl-color-white); }
	.blog__feature { display: grid; grid-template-columns: minmax(14rem, .85fr) minmax(0, 1.15fr); min-height: 20rem; margin-bottom: 4.5rem; overflow: hidden; border: 1px solid var(--sl-color-gray-5); border-radius: 1rem; background: linear-gradient(135deg, color-mix(in srgb, var(--sl-color-text-accent) 12%, var(--sl-color-bg) 88%), var(--sl-color-bg)); }
	.blog__feature > img { width: 100%; height: 100%; min-height: 18rem; object-fit: cover; filter: saturate(.72) contrast(1.08); }
	.blog__feature-copy { display: flex; flex-direction: column; justify-content: center; max-width: 46rem; padding: clamp(1.5rem, 6vw, 4.5rem); }
	.blog__feature h2 { margin: 1.5rem 0 1rem; font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.05; }
	.blog__feature h2 a { color: var(--sl-color-white); text-decoration: none; }
	.blog__feature-copy > p { margin: 0; color: var(--sl-color-gray-3); font-size: var(--sl-text-lg); }
	.blog__read { display: inline-flex; width: fit-content; gap: .5rem; margin-top: 1.75rem; color: var(--sl-color-white); font-weight: 700; text-decoration: none; }
	.blog__archive-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1.25rem; }
	.blog__list { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 1.25rem; margin: 0; padding: 0; list-style: none; }
	:global(.blog-card) { height: 100%; overflow: hidden; border: 1px solid var(--sl-color-gray-5); border-radius: .8rem; background: color-mix(in srgb, var(--sl-color-bg-nav) 68%, var(--sl-color-bg)); }
	:global(.blog-card__image) { display: block; aspect-ratio: 16 / 9; background: var(--sl-color-gray-6); }
	:global(.blog-card__image img) { width: 100%; height: 100%; object-fit: cover; filter: saturate(.68) contrast(1.08); transition: transform 180ms ease; }
	:global(.blog-card:hover .blog-card__image img) { transform: scale(1.03); }
	:global(.blog-card__body) { display: flex; min-height: 18rem; flex-direction: column; padding: 1.1rem; }
	:global(.blog-card__meta), :global(.blog-card__footer) { display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; justify-content: space-between; color: var(--sl-color-gray-3); font-size: var(--sl-text-sm); }
	.blog__meta, .blog__footer { display: flex; flex-wrap: wrap; gap: .75rem; align-items: center; justify-content: space-between; color: var(--sl-color-gray-3); font-size: var(--sl-text-sm); }
	:global(.blog-card h2) { margin: 1rem 0 .55rem; font-size: var(--sl-text-xl); line-height: 1.15; }
	:global(.blog-card h2 a) { color: var(--sl-color-white); text-decoration: none; }
	:global(.blog-card h2 a:hover), :global(.blog-card__footer a:hover) { color: var(--sl-color-text-accent); text-decoration: underline; text-underline-offset: .18em; }
	:global(.blog-card__body > p) { margin: 0; color: var(--sl-color-gray-3); }
	:global(.blog-card__footer) { margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--sl-color-gray-5); }
	:global(.blog-card__footer a), :global(.blog-card__source) { color: var(--sl-color-text-accent); font-weight: 700; text-decoration: none; }
	:global(.blog-card__source) { margin-top: .65rem; font-size: .72rem; font-weight: 500; }
	@media (max-width: 44rem) { .blog__feature { grid-template-columns: 1fr; } .blog__archive-heading { align-items: flex-start; flex-direction: column; } }
	@media (prefers-reduced-motion: reduce) { :global(.blog-card__image img) { transition: none; } }
</style>
