---
import { Code } from 'astro:components';
import { beskidUiSrcUrl } from '../lib/beskid-ui-root.mjs';
import type { LandingTileSectionData } from '../data/landing-tile-sections';
import type { LandingCodeTab } from '../data/landing-code-tabs';
import { cliPackageUrls, loadCliVersion } from '../lib/load-download-versions';
import LandingCodeWindow from './LandingCodeWindow.astro';
import LandingCompareTable, { type CompareRow } from './LandingCompareTable.astro';
import LandingDotNetSection from './LandingDotNetSection.astro';
import type { DotNetBullet } from '../data/landing-dotnet-bullets';
import LandingTileSection from './LandingTileSection.astro';

interface ActionLink {
  text: string;
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  /** Swap href to the OS-appropriate CLI asset at load time (baseline stays `href`). */
  platformDownload?: boolean;
  /** Smooth-scroll to the anchor instead of an instant jump. */
  smoothScroll?: boolean;
}

interface FeatureItem {
  title: string;
  body: string;
}

interface Props {
  title: string;
  tagline: string;
  subtagline?: string;
  versionNote?: string;
  /** Hero code window: one or more tabs (primary API). */
  codeTabs?: LandingCodeTab[];
  /** Opt-in vertical split: code pane on top, terminal output below. */
  codeSplit?: boolean;
  actions?: ActionLink[];
  landingPage?: boolean;
  compareTitle?: string;
  compareLead?: string;
  compareRows?: CompareRow[];
  dotnetTitle?: string;
  dotnetIntro?: string;
  dotnetRightHeading?: string;
  dotnetRightBullets?: DotNetBullet[];
  dotnetWrongHeading?: string;
  dotnetWrongBullets?: DotNetBullet[];
  alreadyBetterSection?: LandingTileSectionData;
  sectionTitle?: string;
  sectionLead?: string;
  principlesIntro?: string;
  features?: FeatureItem[];
  calloutTitle?: string;
  calloutText?: string;
  calloutCodeLabel?: string;
  calloutCode?: string;
  calloutCodeLang?: string;
  calloutNote?: string;
}

const {
  title,
  tagline,
  subtagline = '',
  versionNote = '',
  codeTabs = [],
  codeSplit = false,
  actions = [],
  landingPage = false,
  compareTitle = '',
  compareLead = '',
  compareRows = [],
  dotnetTitle = '',
  dotnetIntro = '',
  dotnetRightHeading = '',
  dotnetRightBullets = [],
  dotnetWrongHeading = '',
  dotnetWrongBullets = [],
  alreadyBetterSection,
  sectionTitle = '',
  sectionLead = '',
  principlesIntro = '',
  features = [],
  calloutTitle = '',
  calloutText = '',
  calloutCodeLabel = '',
  calloutCode = '',
  calloutCodeLang = 'bash',
  calloutNote = '',
} = Astro.props;

const showCompare = compareRows.length > 0;
const showDotnet =
  Boolean(dotnetTitle) &&
  dotnetRightBullets.length > 0 &&
  dotnetWrongBullets.length > 0;
const showAlreadyBetter = Boolean(alreadyBetterSection?.tiles.length);
const showPrinciples = features.length > 0;
const actionVariantClass = (variant?: string) =>
  variant === 'primary' ? 'landing-action--primary' : variant === 'ghost' ? 'landing-action--ghost' : 'landing-action--secondary';

// Build-time CLI asset URLs for the platform-aware Download button.
const cliDownloadUrls = cliPackageUrls(loadCliVersion());
---

<link rel="stylesheet" href={beskidUiSrcUrl('styles/landing.css')} />

<section class:list={['landing-root', 'not-content', landingPage && 'landing-page']}>
  <header class="landing-hero">
    <div class="landing-hero__inner">
      <div class="landing-hero__copy">
        <h1>{title}</h1>
        <p>{tagline}</p>
        {subtagline && <p class="landing-hero__subline">{subtagline}</p>}
        {versionNote && <p class="landing-hero__subline landing-hero__version">{versionNote}</p>}
        {actions.length > 0 && (
          <div class="landing-hero__actions">
            {actions.map((action) => (
              <a
                class:list={['landing-action', actionVariantClass(action.variant)]}
                href={action.href}
                data-platform-download={action.platformDownload ? '' : undefined}
                data-href-macos={action.platformDownload ? cliDownloadUrls['macos-arm64-dmg'] : undefined}
                data-href-windows={action.platformDownload ? cliDownloadUrls['windows-amd64-msi'] : undefined}
                data-href-linux={action.platformDownload ? cliDownloadUrls['linux-amd64-deb'] : undefined}
                data-smooth-scroll={action.smoothScroll ? '' : undefined}
              >
                {action.text}
              </a>
            ))}
          </div>
        )}
      </div>
      <div class="landing-hero__code">
        <LandingCodeWindow tabs={codeTabs} split={codeSplit} />
      </div>
    </div>
  </header>

  {showCompare && (
    <section class="landing-section landing-compare" id="why-beskid">
      <div class="landing-section__inner">
        {compareTitle && <h2>{compareTitle}</h2>}
        {compareLead && <p class="landing-section__lead">{compareLead}</p>}
        <LandingCompareTable rows={compareRows} />
      </div>
    </section>
  )}

  {showPrinciples && (
    <section
      class:list={['landing-section', landingPage ? 'landing-principles' : 'landing-section--features']}
    >
      <div class="landing-section__inner">
        {sectionTitle && <h2>{sectionTitle}</h2>}
        {principlesIntro && <p class="landing-principles__intro">{principlesIntro}</p>}
        {!landingPage && sectionLead && <p class="landing-section__lead">{sectionLead}</p>}
        <div class:list={[landingPage ? 'landing-principles__grid' : 'feature-grid']}>
          {features.map((feature) => (
            <article class:list={[landingPage ? 'landing-principle-card' : 'feature-card']}>
              <h3>{feature.title}</h3>
              <p>{feature.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {showDotnet && (
    <LandingDotNetSection
      title={dotnetTitle}
      intro={dotnetIntro}
      rightHeading={dotnetRightHeading}
      rightBullets={dotnetRightBullets}
      wrongHeading={dotnetWrongHeading}
      wrongBullets={dotnetWrongBullets}
    />
  )}

  {showAlreadyBetter && alreadyBetterSection && <LandingTileSection section={alreadyBetterSection} />}

  {(calloutTitle || calloutText || calloutCode) && (
    <section class="landing-callout landing-section__inner">
      {calloutTitle && <h2>{calloutTitle}</h2>}
      {calloutText && <p>{calloutText}</p>}
      {calloutCode && (
        <div class="landing-callout__code">
          {calloutCodeLabel && <span class="landing-callout__label">{calloutCodeLabel}</span>}
          <div class="landing-terminal__body">
            <Code code={calloutCode} lang={calloutCodeLang} />
          </div>
        </div>
      )}
      {calloutNote && <p class="landing-callout__note">{calloutNote}</p>}
    </section>
  )}
</section>

<script is:inline>
  (function () {
    function initLandingActions() {
      // Platform-aware Download: swap href to the OS-appropriate CLI asset.
      document.querySelectorAll('a[data-platform-download]').forEach(function (a) {
        if (a.dataset.downloadBound === '1') return;
        a.dataset.downloadBound = '1';
        var platform =
          (navigator.userAgentData && navigator.userAgentData.platform) ||
          navigator.platform ||
          '';
        var os = /mac/i.test(platform)
          ? 'macos'
          : /win/i.test(platform)
            ? 'windows'
            : 'linux';
        var url = a.getAttribute('data-href-' + os);
        if (url) a.setAttribute('href', url);
      });

      // Smooth-scroll for in-page anchor links.
      document.querySelectorAll('a[data-smooth-scroll]').forEach(function (a) {
        if (a.dataset.scrollBound === '1') return;
        a.dataset.scrollBound = '1';
        a.addEventListener('click', function (event) {
          var href = a.getAttribute('href') || '';
          if (href.charAt(0) !== '#') return;
          var target = document.querySelector(href);
          if (!target) return;
          event.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });
    }
    initLandingActions();
    document.addEventListener('astro:page-load', initLandingActions);
  })();
</script>
