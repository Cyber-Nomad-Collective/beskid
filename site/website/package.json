  "version": "0.0.1",
  "scripts": {
    "sync:cli-version": "node node_modules/trudoc/scripts/sync-cli-version.mjs",
    "verify:platform-spec": "node node_modules/trudoc/scripts/verify-platform-spec-frontmatter.mjs",
    "verify:graphs": "node node_modules/trudoc/scripts/verify-graph-frontmatter.mjs",
    "verify:diagnostics-spec-sync": "node node_modules/trudoc/scripts/verify-diagnostics-spec-sync.mjs",
    "verify:language-meta-related-links": "node node_modules/trudoc/scripts/verify-language-meta-related-links.mjs",
    "verify:last-reviewed": "node node_modules/trudoc/scripts/verify-last-reviewed.mjs",
    "generate:platform-spec-git-meta": "node node_modules/trudoc/scripts/generate-platform-spec-git-meta.mjs",
    "generate:platform-spec-nav-tree": "bun ./node_modules/trudoc/scripts/generate-platform-spec-nav-tree.mjs",
    "generate:book-nav-tree": "bun ./node_modules/trudoc/scripts/generate-book-nav-tree.mjs",
    "verify:platform-spec-git-meta": "node node_modules/trudoc/scripts/verify-platform-spec-git-meta.mjs",
    "verify:platform-spec-layout": "trudoc-layout",
    "verify:platform-spec-ci": "node node_modules/trudoc/scripts/verify-platform-spec-ci.mjs",
    "verify:platform-spec-content": "node node_modules/trudoc/scripts/verify-platform-spec-content.mjs",
    "verify:trudoc": "trudoc",
    "verify:book-images": "node node_modules/trudoc/scripts/verify-book-images.mjs",
