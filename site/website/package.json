{
	"name": "beskid-website",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"test": "node --test src/lib/*.test.mjs src/lib/*.test.ts",
		"sync:beskid-packages": "bash ../../scripts/sync-beskid-packages.sh site/website",
		"sync:cli-version": "node scripts/run-trudoc.mjs sync-cli-version.mjs",
		"generate:book-nav-tree": "node scripts/run-trudoc.mjs generate-book-nav-tree.mjs",
		"verify:book-images": "node scripts/run-trudoc.mjs verify-book-images.mjs",
		"verify:book-layout": "node scripts/run-trudoc.mjs verify-book-layout.mjs",
		"test:docs-links": "node --test src/lib/remark-beskid-directives.test.mjs",
		"test:blog": "node --test src/lib/blog.test.mjs src/lib/tracker-provenance.test.mjs",
		"prebuild": "pnpm test:docs-links",
		"dev": "astro dev",
		"dev:clean": "rm -rf .astro dist node_modules/.vite && pnpm dev",
		"start": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro"
	},
	"dependencies": {
		"@cyber-nomad-collective/trudoc": "0.2.5",
		"@astrojs/internal-helpers": "0.9.0",
		"@astrojs/starlight": "^0.38.4",
		"@beskid/beskid-ui": "file:../../beskid_web_common/packages/beskid-ui",
		"@beskid/ui-react": "file:../../beskid_web_common/packages/beskid-ui-react",
		"astro": "6.4.6",
		"astro-embed": "^0.13.0",
		"astro-mermaid": "^2.0.1",
		"mermaid": "^11.15.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"sharp": "^0.34.2",
		"trudoc": "npm:@cyber-nomad-collective/trudoc@0.2.5"
	},
	"devDependencies": {
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"tsx": "^4.19.4",
		"yaml": "^2.7.0",
		"zod": "^4.4.3"
	},
	"packageManager": "pnpm@10.17.1"
}
