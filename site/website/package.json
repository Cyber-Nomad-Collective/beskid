    "verify:platform-spec-home-layout": "node node_modules/trudoc/scripts/verify-platform-spec-home-layout.mjs",
    "bootstrap:platform-spec-layout": "bun ./node_modules/trudoc/scripts/bootstrap-platform-spec-layout.ts",
    "prebuild": "node node_modules/trudoc/scripts/website-prebuild.mjs",
    "predev": "node node_modules/trudoc/scripts/website-prebuild.mjs --dev",
    "dev": "astro dev",
    "dev:clean": "rm -rf .astro dist node_modules/.vite && bun run dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro"
