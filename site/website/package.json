    "astro": "6.2.2",
    "astro-embed": "^0.13.0",
    "astro-mermaid": "^2.0.1",
    "mermaid": "^11.15.0",
    "sharp": "^0.34.2",
    "trudoc": "npm:@cyber-nomad-collective/trudoc@^0.1.3"
  },
  "devDependencies": {
    "tsx": "^4.19.4",
    "yaml": "^2.7.0",
    "zod": "^4.4.3"
