{
	"include": ["**/*.ts", "**/*.tsx"],
	"compilerOptions": {
		"target": "ES2022",
		"jsx": "react-jsx",
		"module": "ESNext",
		"paths": {
			"#/*": ["./src/*"],
			"@cyber-nomad-collective/trudoc": [
				"../../beskid_web_common/packages/trudoc/src/index.ts"
			],
			"@cyber-nomad-collective/trudoc/*": [
				"../../beskid_web_common/packages/trudoc/src/*"
			]
		},
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["vite/client", "node"],
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true
	}
}
