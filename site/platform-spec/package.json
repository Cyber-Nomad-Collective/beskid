{
	"name": "beskid-platform-spec",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.17.1",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 8460",
		"build": "pnpm run seed:static && pnpm run verify:seed && vite build && pnpm run seed:bundle && node --import tsx scripts/sync-root-stylesheet.ts && pnpm run verify:client-bundle && pnpm run verify:ssr-bundle",
		"verify:client-bundle": "node --import tsx scripts/verify-client-bundle.ts",
		"verify:ssr-bundle": "node --import tsx scripts/verify-production-ssr-bundle.ts",
		"start": "node .output/server/index.mjs",
		"preview": "vite preview",
		"seed": "node --import tsx scripts/seed.ts",
		"seed:static": "node --import tsx scripts/seed.ts --static",
		"seed:stores": "node --import tsx scripts/seed.ts --stores",
		"seed:graph": "node --import tsx scripts/seed.ts --graph",
		"seed:bundle": "esbuild scripts/seed.ts --bundle --platform=node --format=esm --packages=external --outfile=.output/seed.mjs",
		"verify:seed": "node --import tsx scripts/verify-seed.ts",
		"layouts:check": "node --import tsx scripts/seed.ts --check-layouts",
		"check": "biome check",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"sync:beskid-packages": "bash ../../scripts/sync-beskid-packages.sh site/platform-spec"
	},
	"engines": {
		"node": ">=22.12.0",
		"pnpm": ">=10.17.1"
	},
	"dependencies": {
		"@beskid/auth-client": "file:../../beskid_web_common/packages/beskid-auth-client",
		"@beskid/beskid-ui": "file:../../beskid_web_common/packages/beskid-ui",
		"@beskid/server-observability": "file:../../beskid_web_common/packages/beskid-server-observability",
		"@beskid/ui-react": "file:../../beskid_web_common/packages/beskid-ui-react",
		"@dagrejs/dagre": "^3.0.0",
		"@octokit/rest": "^22.0.1",
		"@t3-oss/env-core": "^0.13.10",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-query": "latest",
		"@tanstack/react-router": "latest",
		"@tanstack/react-start": "latest",
		"@tiptap/core": "3.28.0",
		"@tiptap/extension-code-block-lowlight": "3.28.0",
		"@tiptap/extension-link": "3.28.0",
		"@tiptap/pm": "3.28.0",
		"@tiptap/react": "3.28.0",
		"@tiptap/starter-kit": "3.28.0",
		"@xyflow/react": "^12.11.2",
		"jose": "^6.2.3",
		"lowlight": "^3.3.0",
		"lucide-react": "^0.577.0",
		"marked": "^15.0.12",
		"neo4j-driver": "^5.28.1",
		"next-themes": "^0.4.6",
		"nitro": "^3.0.260522-beta",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwindcss": "^4.1.18",
		"yaml": "^2.9.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@tanstack/devtools-vite": "latest",
		"@tanstack/react-devtools": "latest",
		"@tanstack/react-router-devtools": "latest",
		"@types/node": "^25.9.1",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"esbuild": "^0.25.0",
		"tsx": "^4.20.0",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"vitest": "^3.2.4"
	}
}
