{
	"name": "beskid-platform-spec",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "bun --bun vite dev --port 8460",
	"build": "bun --bun vite build && bun run scripts/sync-root-stylesheet.ts",
		"verify:client-bundle": "bun run scripts/verify-client-bundle.ts",
		"seed": "bun run scripts/seed.ts",
		"seed:force": "bun run scripts/seed.ts --force",
		"validate:spec-content": "bun run scripts/seed.ts",
		"start": "bun run .output/server/index.mjs",
		"preview": "bun --bun vite preview",
		"check": "bunx biome check",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"import:mdx": "bun run scripts/import-mdx-to-memgraph.ts",
		"sync:beskid-packages": "bash ../../scripts/sync-beskid-packages.sh site/platform-spec"
	},
	"engines": {
		"bun": ">=1.2.0"
	},
	"dependencies": {
		"@beskid/auth-client": "npm:@cyber-nomad-collective/beskid-auth-client@^0.2.0",
		"@beskid/server-observability": "npm:@cyber-nomad-collective/beskid-server-observability@^0.2.0",
		"@beskid/ui-react": "npm:@cyber-nomad-collective/beskid-ui-react@^0.2.0",
		"@cyber-nomad-collective/spec-core": "npm:@cyber-nomad-collective/spec-core@^0.2.0",
		"@t3-oss/env-core": "^0.13.10",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-query": "latest",
		"@tanstack/react-router": "latest",
		"@tanstack/react-start": "latest",
		"@octokit/rest": "^22.0.1",
		"jose": "^6.2.3",
		"lucide-react": "^0.577.0",
		"marked": "^15.0.12",
		"neo4j-driver": "^5.28.1",
		"next-themes": "^0.4.6",
		"nitro": "^3.0.260522-beta",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwindcss": "^4.1.18",
		"zod": "^4.3.6",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@tanstack/devtools-vite": "latest",
		"@tanstack/react-devtools": "latest",
		"@tanstack/react-router-devtools": "latest",
		"@types/node": "^25.9.1",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"vitest": "^3.2.4"
	}
}
