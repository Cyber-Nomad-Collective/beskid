# Memgraph (local docker-compose uses bolt://memgraph:7687)
MEMGRAPH_URI=bolt://127.0.0.1:7687

# Shared auth hub
AUTH_HUB_PUBLIC_URL=https://auth.beskid-lang.org

# Session cookie signing (32+ chars)
SESSION_SECRET=

# Public origin for this service
PLATFORM_SPEC_PUBLIC_URL=http://127.0.0.1:8460

# Beskid superrepository (OpenSpec change PR target)
GITHUB_REPO_OWNER=Cyber-Nomad-Collective
GITHUB_REPO_NAME=beskid
# Beskid OAuth app home repo
GITHUB_OAUTH_REPO_OWNER=Cyber-Nomad-Collective
GITHUB_OAUTH_REPO_NAME=beskid

# Optional GitHub webhook for merged editor changes
# GITHUB_WEBHOOK_SECRET=

# Comma-separated GitHub logins with moderator role
# PLATFORM_SPEC_MODERATOR_LOGINS=alice,bob

# Default pairing approver when no admin session
# PLATFORM_SPEC_PAIRING_APPROVER_LOGIN=

# Protect re-setup when already paired
# PLATFORM_SPEC_SETUP_TOKEN=

# Persisted runtime data
# PLATFORM_SPEC_DATA_DIR=data/runtime

PORT=8460
