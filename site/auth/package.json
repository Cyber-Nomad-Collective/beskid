{
	"name": "beskid-auth",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "bun --bun vite dev --port 8090",
		"build": "bun --bun vite build && bash scripts/sync-root-stylesheet.sh",
		"verify:client-bundle": "bash scripts/verify-client-bundle.sh",
		"start": "bun run .output/server/index.mjs",
		"preview": "bun --bun vite preview",
		"check": "bunx biome check",
		"typecheck": "tsc --noEmit",
		"test": "bun --bun vitest run",
		"test:bundle": "VERIFY_CLIENT_BUNDLE=1 bun --bun vitest run src/scripts/verify-client-bundle.test.ts",
		"sync:beskid-packages": "bash ../../scripts/sync-beskid-packages.sh site/auth"
	},
	"engines": {
		"bun": ">=1.2.0"
	},
	"dependencies": {
		"@beskid/auth-client": "npm:@cyber-nomad-collective/beskid-auth-client@latest",
		"@beskid/beskid-ui": "npm:@cyber-nomad-collective/beskid-ui@latest",
		"@beskid/ui-react": "npm:@cyber-nomad-collective/beskid-ui-react@latest",
		"@t3-oss/env-core": "^0.13.10",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-query": "latest",
		"@tanstack/react-router": "latest",
		"@tanstack/react-start": "latest",
		"jose": "^6.2.3",
		"lucide-react": "^0.577.0",
		"next-themes": "^0.4.6",
		"nitro": "^3.0.260522-beta",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwindcss": "^4.1.18",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@tanstack/devtools-vite": "latest",
		"@tanstack/react-devtools": "latest",
		"@tanstack/react-router-devtools": "latest",
		"@types/node": "^25.9.1",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"vitest": "^4.1.5"
	}
}
