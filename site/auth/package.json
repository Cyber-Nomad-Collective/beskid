{
	"name": "beskid-auth",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.17.1",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "pnpm vite dev --port 8090",
		"build": "pnpm vite build && bash scripts/sync-root-stylesheet.sh",
		"verify:client-bundle": "bash scripts/verify-client-bundle.sh",
		"start": "node .output/server/index.mjs",
		"preview": "pnpm vite preview",
		"check": "pnpm exec biome check",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:bundle": "VERIFY_CLIENT_BUNDLE=1 vitest run src/scripts/verify-client-bundle.test.ts",
		"sync:beskid-packages": "bash ../../scripts/sync-beskid-packages.sh site/auth"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"dependencies": {
		"@beskid/auth-client": "file:../../beskid_web_common/packages/beskid-auth-client",
		"@beskid/beskid-ui": "file:../../beskid_web_common/packages/beskid-ui",
		"@beskid/server-observability": "file:../../beskid_web_common/packages/beskid-server-observability",
		"@beskid/ui-react": "file:../../beskid_web_common/packages/beskid-ui-react",
		"@t3-oss/env-core": "^0.13.10",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-query": "latest",
		"@tanstack/react-router": "latest",
		"@tanstack/react-start": "latest",
		"better-sqlite3": "13.0.1",
		"jose": "^6.2.3",
		"lucide-react": "^0.577.0",
		"next-themes": "^0.4.6",
		"nitro": "3.0.260610-beta",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwindcss": "^4.1.18",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@tanstack/devtools-vite": "latest",
		"@tanstack/react-devtools": "latest",
		"@tanstack/react-router-devtools": "latest",
		"@types/better-sqlite3": "7.6.13",
		"@types/node": "^25.9.1",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"vitest": "^4.1.5"
	}
}
