# Public URL of this hub
AUTH_HUB_PUBLIC_URL=https://auth.beskid-lang.org

# Shared handoff JWT secret (32+ chars) — same on tracker, nexus, pckg
AUTH_HUB_SECRET=

# Hub session cookie signing (32+ chars)
SESSION_SECRET=

# GitHub OAuth App — callback {AUTH_HUB_PUBLIC_URL}/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=https://auth.beskid-lang.org/callback

# Protect re-setup when already onboarded
# AUTH_SETUP_TOKEN=

# Onboarding admin logins are optional — leave empty and the first GitHub sign-in becomes hub admin.

# Optional env overrides for consumer public URLs
TRACKER_PUBLIC_URL=https://tracker.beskid-lang.org
NEXUS_PUBLIC_URL=https://nexus.beskid-lang.org
PCKG_PUBLIC_URL=https://pckg.beskid-lang.org

# Persisted config (onboarding writes auth-config.json here)
# AUTH_DATA_DIR=data/runtime

PORT=8090
