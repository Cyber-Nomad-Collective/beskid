{
	"name": "beskid-learn",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev:server": "pnpm exec bun run server.ts",
		"dev": "pnpm exec vite --host",
		"check": "biome check src",
		"build": "pnpm exec vite build",
		"build:server": "pnpm exec bun build server.ts --outdir .server",
		"typecheck": "tsc --noEmit",
		"preview": "pnpm exec vite preview --host 0.0.0.0 --port 4173",
		"start": "pnpm exec bun run server.ts",
		"lesson:check": "pnpm exec node scripts/check-lesson.mjs",
		"lessons:list": "node -e \"const fs=require('node:fs');const entries=fs.readdirSync('curriculum',{withFileTypes:true}).filter((entry)=>entry.isDirectory()&&/^\\d{2}-/.test(entry.name)).map((entry)=>entry.name).sort().join(' ');console.log(entries);\"",
		"check:all": "pnpm run -s lessons:list | xargs -n1 -P1 pnpm run lesson:check",
		"sync:beskid-packages": "bash ../../scripts/sync-beskid-packages.sh site/learn"
	},
	"dependencies": {
		"@beskid/beskid-ui": "file:../../beskid_web_common/packages/beskid-ui",
		"@beskid/ui-react": "file:../../beskid_web_common/packages/beskid-ui-react",
		"@monaco-editor/react": "^4.7.0",
		"@tanstack/react-router": "^1.114.0",
		"@xterm/addon-fit": "^0.10.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lottie-react": "^2.4.0",
		"lucide-react": "^0.468.0",
		"monaco-editor": "^0.52.2",
		"next-themes": "^0.4.4",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwind-merge": "^2.6.0",
		"xterm": "^5.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.3.14",
		"@types/node": "^22.13.9",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^4.3.2",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.7.2",
		"vite": "^6.0.1"
	},
	"packageManager": "pnpm@10.17.1"
}
