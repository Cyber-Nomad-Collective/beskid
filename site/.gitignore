# site/ — shared ignores for auth and website

# Dependencies (bun.lock is committed in each app)
node_modules/

# Environment (examples stay tracked)
.env
.env.local
.env.*.local

# OS
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# site/auth — TanStack Start / Nitro (beskid-auth)
# ---------------------------------------------------------------------------
auth/.output/
auth/.nitro/
auth/.tanstack/
auth/.vinxi/
auth/dist/
auth/dist-ssr/
auth/__unconfig*

# Local SQLite + migrated config (production uses AUTH_DATA_DIR volume)
auth/data/runtime/*
!auth/data/runtime/.gitkeep

# ---------------------------------------------------------------------------
# site/website — Astro + trudoc generated artifacts
# ---------------------------------------------------------------------------
website/.astro/
website/dist/

# Generated at build time by packages/trudoc/scripts/sync-cli-version.mjs
website/src/data/cli-version.json
website/src/data/vscode-extension.json

# Generated by packages/trudoc/scripts/generate-platform-spec-git-meta.mjs
website/src/generated/platform-spec-git-meta.json

# Mirrored to public/ by generate-platform-spec-nav-tree (served at /generated/platform-spec-nav-tree.json)
website/public/generated/platform-spec-nav-tree.json

# Mirrored to public/ by generate-platform-spec-catalog (tracker docs management API)
website/public/generated/platform-spec-catalog.json
website/public/generated/platform-spec-docs/
