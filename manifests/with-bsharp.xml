<?xml version="1.0" encoding="UTF-8"?>
<!--
  Same as default.xml but syncs references/bsharp without -g bsharp.
  Init: repo init -u … -m manifests/with-bsharp.xml
-->
<manifest>
  <remote name="cnc" fetch="https://github.com/Cyber-Nomad-Collective/" />
  <remote name="github" fetch="https://github.com/" />

  <default remote="cnc" revision="main" sync-j="4" />

  <project name="beskid" path="." revision="main" />
  <project name="beskid_compiler" path="compiler" revision="main" />
  <project name="beskid_standard" path="compiler/corelib" revision="main" />
  <project name="beskid_pckg" path="pckg" revision="main" />
  <project name="beskid_vscode" path="beskid_vscode" revision="main" />
  <project name="beskid_templates" path="beskid_templates" revision="main" />
  <project
    name="pmikstacki/beskid_tracker"
    path="beskid_tracker"
    remote="github"
    revision="main" />
  <project
    name="pmikstacki/bsharp"
    path="references/bsharp"
    remote="github"
    revision="main"
    clone-depth="1" />
</manifest>
