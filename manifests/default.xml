<?xml version="1.0" encoding="UTF-8"?>
<!--
  Beskid superrepo manifest for Google's git-repo tool.
  Init: repo init -u https://github.com/Cyber-Nomad-Collective/beskid.git -m manifests/default.xml
  Sync:  repo sync   (optional reference: repo sync -g bsharp)
-->
<manifest>
  <remote name="cnc" fetch="https://github.com/Cyber-Nomad-Collective/" />
  <remote name="github" fetch="https://github.com/" />

  <default remote="cnc" revision="main" sync-j="4" />

  <!-- Aggregate tree (site/, packages/, ci/, docs, …) -->
  <project name="beskid" path="." revision="main" />

  <project name="beskid_compiler" path="compiler" revision="main" />
  <project name="beskid_standard" path="compiler/corelib" revision="main" />

  <project name="beskid_pckg" path="pckg" revision="main" />
  <project name="beskid_vscode" path="beskid_vscode" revision="main" />
  <project name="beskid_templates" path="beskid_templates" revision="main" />
  <project name="beskid_nexus" path="beskid_nexus" revision="main" />
  <project name="beskid_web_common" path="beskid_web_common" revision="main" />

  <project
    name="pmikstacki/beskid_tracker"
    path="beskid_tracker"
    remote="github"
    revision="main" />

  <!-- Inactive in .gitmodules by default (large nested Roslyn tree). -->
  <project
    name="pmikstacki/bsharp"
    path="references/bsharp"
    remote="github"
    revision="main"
    groups="notdefault,bsharp"
    clone-depth="1" />
</manifest>
