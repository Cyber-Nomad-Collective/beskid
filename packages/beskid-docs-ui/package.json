{
	"name": "@beskid/docs-ui",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./shell-css": "./shell-css.mjs",
		"./data/beskid-services": "./src/data/beskid-services.ts",
		"./client/beskid-hub": "./src/client/beskid-hub.ts",
		"./client/beskid-hub-entry": "./src/client/beskid-hub-entry.ts",
		"./react/BeskidHub": "./src/react/BeskidHub.tsx",
		"./styles/hub.css": "./src/styles/hub.css",
		"./platform-spec/*": "./src/platform-spec/*",
		"./starlight/*": "./src/starlight/*"
	},
	"scripts": {
		"build:hub-client": "esbuild src/client/beskid-hub-entry.ts --bundle --format=esm --outfile=dist/beskid-hub.mjs --platform=browser",
		"sync:hub-assets": "bun run build:hub-client && cp src/styles/hub.css ../../pckg/src/Server/wwwroot/beskid-hub.css && cp dist/beskid-hub.mjs ../../pckg/src/Server/wwwroot/beskid-hub.mjs"
	},
	"peerDependencies": {
		"@astrojs/starlight": ">=0.30.0",
		"astro": ">=5.0.0",
		"react": ">=18.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"devDependencies": {
		"esbuild": "0.25.0"
	},
	"dependencies": {
		"@material/material-color-utilities": "^0.4.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"unified": "^11.0.5",
		"astro-navbar": "^2.4.0",
		"@dagrejs/dagre": "^1.1.5",
		"d3": "^7.9.0",
		"intro.js": "^8.3.2",
		"trudoc": "workspace:*"
	}
}
