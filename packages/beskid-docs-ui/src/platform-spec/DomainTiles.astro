---
import { getCollection } from 'astro:content';
import { readPlatformSpecNavTreeOrThrow } from 'trudoc/platform-spec';
import { docEntryHref, docEntrySlug, normalizeDocSlug } from './specSlug';
import { SKIP_NAV_DOMAINS } from 'trudoc/platform-spec';
import {
	domainStatsFromNavTree,
	domainTileBadges,
	mergeDomainTileStats,
	standingCountsForDomain,
} from './platformSpecHomeData';

interface Props {
	pathPrefix: string;
	heading?: string;
	/** Show nav + standing badges on domain hub tiles (platform-spec home). */
	showBadges?: boolean;
	/** Omit section h2 (platform-spec index browse). */
	hideHeading?: boolean;
}

const { pathPrefix, heading = 'Explore', showBadges = false, hideHeading = false } = Astro.props;
const base = normalizeDocSlug(pathPrefix);
const cwd = process.cwd();
const isPlatformSpecRoot = base === 'platform-spec';

const all = await getCollection('docs');

const descendants = all.filter((e) => {
	const s = docEntrySlug(e);
	if (s === base) return false;
	return s.startsWith(`${base}/`);
});

const childKeys = new Set<string>();
for (const e of descendants) {
	const s = docEntrySlug(e);
	if (!s.startsWith(`${base}/`)) continue;
	const rest = s.slice(base.length + 1);
	const first = rest.split('/')[0];
	if (first) childKeys.add(first);
}

let navStatsByDomain: ReturnType<typeof domainStatsFromNavTree> | undefined;
if (showBadges && isPlatformSpecRoot) {
	try {
		navStatsByDomain = domainStatsFromNavTree(readPlatformSpecNavTreeOrThrow(cwd).tree);
	} catch {
		navStatsByDomain = undefined;
	}
}

const visibleKeys = isPlatformSpecRoot
	? [...childKeys].filter((key) => !SKIP_NAV_DOMAINS.has(key))
	: [...childKeys];

const tiles = visibleKeys.sort().map((key) => {
	const entry =
		descendants.find((e) => docEntrySlug(e) === `${base}/${key}`) ??
		descendants.find((e) => docEntrySlug(e).startsWith(`${base}/${key}/`));
	const title = entry?.data.title ?? key;
	const desc = entry && 'description' in entry.data ? String(entry.data.description ?? '') : '';
	const slug = entry ? docEntrySlug(entry) : `${base}/${key}`;
	const domainSlug = `${base}/${key}`;
	const badges =
		showBadges && isPlatformSpecRoot
			? domainTileBadges(
					mergeDomainTileStats(
						navStatsByDomain?.get(domainSlug),
						standingCountsForDomain(all, domainSlug, docEntrySlug),
					),
				)
			: [];
	return { key, title, desc, href: docEntryHref(slug), badges };
});
---

{
	tiles.length > 0 && (
		<section
			class="platform-spec-tiles"
			aria-label={hideHeading ? 'Specification domains' : undefined}
			aria-labelledby={hideHeading ? undefined : 'platform-spec-tiles-heading'}
		>
			{
				!hideHeading && (
					<h2 id="platform-spec-tiles-heading" class="platform-spec-tiles__heading">
						{heading}
					</h2>
				)
			}
			<ul class="platform-spec-tiles__grid">
				{tiles.map((t) => (
					<li>
						<a class="platform-spec-tile" href={t.href}>
							<span class="platform-spec-tile__head">
								<span class="platform-spec-tile__title">{t.title}</span>
								{t.badges.length > 0 && (
									<span class="platform-spec-tile__badges" aria-label="Scope">
										{t.badges.map((b) => (
											<span class:list={['platform-spec-tile__badge', `platform-spec-tile__badge--${b.variant}`]}>
												{b.label}
											</span>
										))}
									</span>
								)}
							</span>
							{t.desc && <span class="platform-spec-tile__desc">{t.desc}</span>}
						</a>
					</li>
				))}
			</ul>
		</section>
	)
}
