---
interface Props {
	idTabBrowse: string;
	idTabMap: string;
	idPanelBrowse: string;
	idPanelMap: string;
}

const { idTabBrowse, idTabMap, idPanelBrowse, idPanelMap } = Astro.props;
---

<div class="platform-spec-home__tabs" role="tablist" aria-label="Platform map">
	<button
		type="button"
		class="platform-spec-home__tab is-active"
		role="tab"
		id={idTabBrowse}
		aria-controls={idPanelBrowse}
		data-tab="browse"
		aria-selected="true"
	>
		Browse
	</button>
	<button
		type="button"
		class="platform-spec-home__tab"
		role="tab"
		id={idTabMap}
		aria-controls={idPanelMap}
		data-tab="map"
		aria-selected="false"
		tabindex="-1"
	>
		Map
	</button>
</div>
