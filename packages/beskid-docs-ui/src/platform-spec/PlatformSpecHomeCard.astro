---
interface Props {
	class?: string;
	/** Element id for aria-labelledby on the card root. */
	headingId: string;
}

const { class: className, headingId } = Astro.props;
---

<section class:list={['platform-spec-home-card', className]} aria-labelledby={headingId}>
	<slot name="heading" />
	<div class="platform-spec-home-card__body">
		<slot />
	</div>
</section>
