---
import { githubCommitUrl } from 'trudoc/platform-spec';
import PlatformSpecHomeCard from './PlatformSpecHomeCard.astro';
import type { LatestSpecChange } from './platformSpecHomeData';

const headingId = 'platform-spec-latest-changes-title';

interface Props {
	changes: LatestSpecChange[];
	repo: string;
	gitAvailable: boolean;
}

const { changes, repo, gitAvailable } = Astro.props;
---

<PlatformSpecHomeCard class="platform-spec-latest-changes" headingId={headingId}>
	<h2 slot="heading" id={headingId} class="platform-spec-latest-changes__title">Latest changes</h2>
	{
		changes.length === 0 ? (
			<p class="platform-spec-latest-changes__empty">
				{gitAvailable
					? 'No recent commits in the generated git meta map.'
					: 'Git was unavailable at build time—run generate:platform-spec-git-meta for revision history.'}
			</p>
		) : (
			<ul class="platform-spec-latest-changes__list">
				{changes.map((c) => (
					<li class="platform-spec-latest-changes__item">
						<div class="platform-spec-latest-changes__meta">
							<time datetime={c.date}>{c.date.slice(0, 10)}</time>
							<a
								href={githubCommitUrl(repo, c.hash)}
								class="platform-spec-latest-changes__hash"
								rel="noopener noreferrer"
								target="_blank"
							>
								{c.hash.slice(0, 7)}
							</a>
						</div>
						<p class="platform-spec-latest-changes__subject">{c.subject}</p>
						<p class="platform-spec-latest-changes__page">
							{c.href ? (
								<a href={c.href}>{c.pageTitle}</a>
							) : (
								<span>{c.pageTitle}</span>
							)}
						</p>
					</li>
				))}
			</ul>
		)
	}
</PlatformSpecHomeCard>
