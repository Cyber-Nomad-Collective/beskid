---
import { readPlatformSpecNavTreeOrThrow } from 'trudoc/platform-spec';
import PlatformSpecNavBranch from './PlatformSpecNavBranch.astro';

interface Props {
	currentPath: string;
	isMapPage?: boolean;
}

const { currentPath, isMapPage = false } = Astro.props;
const pathNorm = currentPath.replace(/\/+$/, '') || '/';
const { tree } = readPlatformSpecNavTreeOrThrow(process.cwd());
const branchNodes = tree.children ?? [];
---

<div
	class="platform-spec-nav-chrome"
	data-platform-spec-nav-chrome
	data-map-page={isMapPage ? 'true' : 'false'}
	data-rail-collapsed="true"
>
	<div class="platform-spec-nav-chrome__backdrop" data-platform-spec-nav-backdrop hidden />

	<aside
		id="platform-spec-nav-rail"
		class="platform-spec-nav-chrome__rail"
		aria-label="Platform specification hierarchy"
		data-platform-spec-nav-rail
	>
		{
			!isMapPage && (
				<div class="platform-spec-nav-chrome__rail-head">
					<a href="/platform-spec/" class="platform-spec-nav-chrome__map-link">
						Platform map
					</a>
					<button
						type="button"
						class="platform-spec-nav-chrome__rail-close md:sl-hidden"
						aria-label="Close specification tree"
						data-platform-spec-nav-close
					>
						×
					</button>
				</div>
			)
		}
		{
			isMapPage && (
				<div class="platform-spec-nav-chrome__rail-head platform-spec-nav-chrome__rail-head--index">
					<button
						type="button"
						class:list={['platform-spec-nav-chrome__rail-close', 'md:sl-hidden']}
						aria-label="Close specification tree"
						data-platform-spec-nav-close
					>
						×
					</button>
				</div>
			)
		}
		<label class="platform-spec-nav-chrome__filter">
			<span class="platform-spec-nav-chrome__filter-label">Filter</span>
			<input
				type="search"
				class="platform-spec-nav-chrome__filter-input"
				placeholder="Filter pages…"
				autocomplete="off"
				spellcheck="false"
				data-platform-spec-nav-filter
			/>
		</label>
		<nav class="platform-spec-nav-chrome__tree">
			<PlatformSpecNavBranch nodes={branchNodes} currentPath={pathNorm} />
		</nav>
	</aside>
</div>

<script>
	import '../client/platform-spec-nav.ts';
</script>
