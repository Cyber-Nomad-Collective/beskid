---
import DomainTiles from './DomainTiles.astro';
import PlatformSpecGraphShell from './PlatformSpecGraphShell.astro';
import PlatformSpecHomeGuide from './PlatformSpecHomeGuide.astro';
import PlatformSpecHomeTabs from './PlatformSpecHomeTabs.astro';
import PlatformSpecLatestChanges from './PlatformSpecLatestChanges.astro';
import { websiteRelativeDocPath } from './specDocPath';
import { docEntrySlug } from './specSlug';
import {
	collectLatestSpecChanges,
	docTitlesByWebsitePath,
} from './platformSpecHomeData';
import { getCollection } from 'astro:content';
import { loadPlatformSpecGitMeta } from 'trudoc/platform-spec';

/** Stable, route-scoped ids (unique per page if multiple hubs are ever embedded). */
const pathKey =
	Astro.url.pathname
		.replace(/\/+$/, '')
		.replace(/^\/+/, '')
		.replace(/\//g, '-') || 'root';
const uid = `psh-${pathKey.replace(/[^a-zA-Z0-9-]/g, '')}`;
const idTabMap = `${uid}-tab-map`;
const idTabBrowse = `${uid}-tab-browse`;
const idPanelMap = `${uid}-panel-map`;
const idPanelBrowse = `${uid}-panel-browse`;

const cwd = process.cwd();
const allDocs = await getCollection('docs');
const gitMeta = loadPlatformSpecGitMeta(cwd);
const latestChanges = collectLatestSpecChanges(
	gitMeta,
	docTitlesByWebsitePath(allDocs, (slug) => websiteRelativeDocPath(cwd, slug) ?? '', docEntrySlug),
);
---

<div class="platform-spec-home" data-platform-spec-home data-active-tab="browse">
	<header class="platform-spec-home__header">
		<PlatformSpecHomeTabs
			idTabBrowse={idTabBrowse}
			idTabMap={idTabMap}
			idPanelBrowse={idPanelBrowse}
			idPanelMap={idPanelMap}
		/>
	</header>
	<div
		id={idPanelBrowse}
		class="platform-spec-home__panel platform-spec-home__panel--browse"
		role="tabpanel"
		aria-labelledby={idTabBrowse}
		data-tab-panel="browse"
	>
		<div class="platform-spec-home__browse-inner">
			<DomainTiles pathPrefix="platform-spec" showBadges hideHeading />
			<div class="platform-spec-home__footer">
				<PlatformSpecLatestChanges
					changes={latestChanges}
					repo={gitMeta.repo}
					gitAvailable={gitMeta.gitAvailable}
				/>
				<PlatformSpecHomeGuide />
			</div>
		</div>
	</div>
	<div
		id={idPanelMap}
		class="platform-spec-home__panel"
		role="tabpanel"
		aria-labelledby={idTabMap}
		data-tab-panel="map"
		hidden
	>
		<div class="platform-spec-map-page">
			<PlatformSpecGraphShell />
		</div>
	</div>
</div>

<script>
	import '../client/platform-spec-home-tabs.ts';
</script>
