---
type ArchitectureGraphNode = {
	id: string;
	label: string;
	group?: string;
	description?: string;
	href?: string;
	tags?: string[];
	meta?: Record<string, string>;
	hidden?: boolean;
};

type ArchitectureGraphEdge = {
	id?: string;
	from: string;
	to: string;
	label?: string;
	description?: string;
	hidden?: boolean;
};

type ArchitectureGraphGroup = {
	id: string;
	label: string;
	color?: string;
	description?: string;
};

type ArchitectureGraphPayload = {
	title?: string;
	description?: string;
	nodes: ArchitectureGraphNode[];
	edges: ArchitectureGraphEdge[];
	groups?: ArchitectureGraphGroup[];
};

interface Props {
	id?: string;
	graph: ArchitectureGraphPayload;
}

const { graph, id = `architecture-graph-${Math.random().toString(36).slice(2, 10)}` } = Astro.props;
---

<section class="architecture-graph-shell" data-architecture-graph-root data-graph-id={id}>
	<header class="architecture-graph-shell__header">
		<h2 class="architecture-graph-shell__title">{graph.title ?? 'Architecture graph'}</h2>
		{graph.description && <p class="architecture-graph-shell__desc">{graph.description}</p>}
	</header>
	<div
		class="architecture-graph-shell__canvas"
		data-architecture-graph-canvas
		aria-label="Architecture graph canvas"
	></div>
</section>

<script type="application/json" id={`${id}-data`} set:html={JSON.stringify(graph)} />

<script>
	import '../client/architecture-graph-client.ts';
</script>
