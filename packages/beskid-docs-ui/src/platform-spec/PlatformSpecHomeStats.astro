---
interface Props {
	domains: number;
	areas: number;
	features: number;
	specNodes: number;
}

const { domains, areas, features, specNodes } = Astro.props;
---

<ul class="platform-spec-home__stats" aria-label="Specification scope">
	<li>
		<span class="platform-spec-home__stats-value">{domains}</span>
		<span class="platform-spec-home__stats-label">Domains</span>
	</li>
	<li>
		<span class="platform-spec-home__stats-value">{areas}</span>
		<span class="platform-spec-home__stats-label">Areas</span>
	</li>
	<li>
		<span class="platform-spec-home__stats-value">{features}</span>
		<span class="platform-spec-home__stats-label">Features</span>
	</li>
	<li>
		<span class="platform-spec-home__stats-value">{specNodes}</span>
		<span class="platform-spec-home__stats-label">Spec nodes</span>
	</li>
</ul>
