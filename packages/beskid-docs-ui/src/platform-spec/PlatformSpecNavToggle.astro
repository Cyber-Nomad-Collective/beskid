---
/** Opens hierarchy rail; on map index also shown on desktop top bar (no collapsed rail strip). */
interface Props {
	showInTopBar?: boolean;
}

const { showInTopBar = false } = Astro.props;
---

<button
	type="button"
	class:list={['platform-spec-nav-toggle', 'print:hidden', !showInTopBar && 'md:sl-hidden']}
	aria-expanded="false"
	aria-controls="platform-spec-nav-rail"
	aria-label="Open specification tree"
	data-platform-spec-nav-mobile-toggle
>
	<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"></path>
	</svg>
</button>
