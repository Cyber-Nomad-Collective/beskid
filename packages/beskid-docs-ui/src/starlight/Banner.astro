---
import DefaultBanner from '@astrojs/starlight/components/Banner.astro';
import BookReaderShell from '../book/BookReaderShell.astro';

const { starlightRoute } = Astro.locals;
const entryId = starlightRoute.entry.id;
const isBook = entryId === 'book' || entryId.startsWith('book/');
const useReader = isBook && starlightRoute.entry.data.template !== 'splash';
---

{useReader && (
	<BookReaderShell
		entryId={entryId}
		title={starlightRoute.entry.data.title}
		description={starlightRoute.entry.data.description}
	/>
)}
<DefaultBanner />
