---
/** Opens book hierarchy rail on mobile (desktop: persistent rail, no toggle). */
---

<button
	type="button"
	class="platform-spec-nav-toggle print:hidden md:sl-hidden"
	aria-expanded="false"
	aria-controls="book-nav-rail"
	aria-label="Open book contents"
	data-book-nav-mobile-toggle
>
	<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"></path>
	</svg>
</button>
