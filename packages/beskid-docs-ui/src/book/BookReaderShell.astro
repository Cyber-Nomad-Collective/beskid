---
import type { BookPrevNext } from 'trudoc/book';
import { displayTitleForSlug, readBookNavTreeOrThrow } from 'trudoc/book';

interface Props {
	entryId: string;
	title: string;
	description?: string;
}

const { entryId, title, description } = Astro.props;

const slug = entryId.replace(/\/index$/, '').replace(/^\//, '') || 'book';
let prevNext: BookPrevNext = {};
let readerTitle = title;

try {
	const nav = readBookNavTreeOrThrow(process.cwd());
	prevNext = nav.prevNextBySlug[slug] ?? {};
	readerTitle = displayTitleForSlug(nav.displayTitleBySlug ?? {}, slug, title);
} catch {
	/* prebuild / missing generated file */
}

const showChapterNav = Boolean(prevNext.prev || prevNext.next);
---

<div class="book-reader" data-book-reader data-book-slug={slug}>
	<header class="book-reader__header">
		<h1 class="book-reader__title">{readerTitle}</h1>
		{description && <p class="book-reader__description">{description}</p>}
	</header>
	<div class="book-reader__body" data-book-reader-body></div>
	{
		showChapterNav && (
			<nav class="book-reader__chapter-nav" aria-label="Chapter navigation">
				{prevNext.prev ? (
					<a class="book-reader__chapter-btn book-reader__chapter-btn--prev" href={prevNext.prev.href} rel="prev">
						<span class="book-reader__chapter-label">← Previous</span>
						<span class="book-reader__chapter-title">{prevNext.prev.title}</span>
					</a>
				) : null}
				{prevNext.next ? (
					<a class="book-reader__chapter-btn book-reader__chapter-btn--next" href={prevNext.next.href} rel="next">
						<span class="book-reader__chapter-label">Next →</span>
						<span class="book-reader__chapter-title">{prevNext.next.title}</span>
					</a>
				) : null}
			</nav>
		)
	}
</div>

<script>
	import '../client/book-reader-layout.ts';
</script>
