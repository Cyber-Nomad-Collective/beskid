{
  "version": 2,
  "title": "Reference build pipeline",
  "description": "Implementation-facing stages from project resolution through lowering to JIT or AOT backends, aligned with the Beskid compiler workspace layout.",
  "groups": [
    {
      "id": "inputs",
      "label": "Inputs",
      "color": "#60a5fa"
    },
    {
      "id": "analysis",
      "label": "Analysis",
      "color": "#a78bfa"
    },
    {
      "id": "codegen",
      "label": "Codegen",
      "color": "#f472b6"
    },
    {
      "id": "backends",
      "label": "Backends",
      "color": "#4ade80"
    }
  ],
  "nodes": [
    {
      "id": "resolve",
      "label": "Project resolution",
      "group": "inputs",
      "description": "Resolve Project.proj / Workspace.proj, build compile plan, materialize workspace and Project.lock when applicable.",
      "href": "/platform-spec/compiler/build-pipeline/dependency-workspace/",
      "links": [
        {
          "kind": "specNode",
          "slug": "platform-spec/compiler/build-pipeline/dependency-workspace"
        }
      ],
      "kind": "compilerPipelineStage",
      "props": {
        "crate": "beskid_analysis",
        "entry": "resolve_input / resolve_project_with_policy",
        "phase": "resolve"
      }
    },
    {
      "id": "parse",
      "label": "Parse and validate",
      "group": "analysis",
      "description": "Parse Beskid source to AST; CLI may validate before lowering.",
      "href": "/platform-spec/compiler/build-pipeline/diagnostics-parity/",
      "links": [
        {
          "kind": "specNode",
          "slug": "platform-spec/compiler/build-pipeline/diagnostics-parity"
        }
      ],
      "kind": "compilerPipelineStage",
      "props": {
        "crate": "beskid_analysis",
        "entry": "parse_program_with_source_name",
        "phase": "parse"
      }
    },
    {
      "id": "lower",
      "label": "lower_source",
      "group": "codegen",
      "description": "HIR, resolution, typing, and Cranelift lowering to CodegenArtifact.",
      "href": "/platform-spec/compiler/build-pipeline/stage-ordering/",
      "links": [
        {
          "kind": "specNode",
          "slug": "platform-spec/compiler/build-pipeline/stage-ordering"
        }
      ],
      "kind": "compilerPipelineStage",
      "props": {
        "crate": "beskid_codegen",
        "entry": "lower_source",
        "phase": "lower"
      }
    },
    {
      "id": "jit",
      "label": "JIT execution",
      "group": "backends",
      "description": "Compile artifact in-process and invoke entrypoint (e.g. beskid run).",
      "href": "/platform-spec/compiler/build-pipeline/backends-jit-aot/",
      "links": [
        {
          "kind": "specNode",
          "slug": "platform-spec/compiler/build-pipeline/backends-jit-aot"
        }
      ],
      "kind": "compilerPipelineStage",
      "props": {
        "crate": "beskid_engine",
        "entry": "run_entrypoint",
        "phase": "jit"
      }
    },
    {
      "id": "aot",
      "label": "AOT build",
      "group": "backends",
      "description": "Emit object, prepare runtime archive strategy, native link (e.g. beskid build).",
      "href": "/platform-spec/compiler/build-pipeline/backends-jit-aot/",
      "links": [
        {
          "kind": "specNode",
          "slug": "platform-spec/compiler/build-pipeline/backends-jit-aot"
        }
      ],
      "kind": "compilerPipelineStage",
      "props": {
        "crate": "beskid_aot",
        "entry": "build",
        "phase": "aot"
      }
    },
    {
      "id": "lsp",
      "label": "LSP diagnostics",
      "group": "analysis",
      "description": "Editor diagnostics path: parse or cached snapshot plus semantic rules.",
      "href": "/platform-spec/compiler/build-pipeline/diagnostics-parity/",
      "links": [
        {
          "kind": "specNode",
          "slug": "platform-spec/compiler/build-pipeline/diagnostics-parity"
        }
      ],
      "kind": "compilerPipelineStage",
      "props": {
        "crate": "beskid_lsp",
        "entry": "analyze_document",
        "phase": "lsp"
      }
    }
  ],
  "edges": [
    {
      "kind": "feeds",
      "from": "resolve",
      "to": "parse",
      "label": "source path",
      "description": "Resolved source_path and source text feed parse/validate.",
      "props": {}
    },
    {
      "kind": "feeds",
      "from": "parse",
      "to": "lower",
      "label": "program",
      "description": "lower_source parses again internally then runs full pipeline.",
      "props": {}
    },
    {
      "kind": "feeds",
      "from": "lower",
      "to": "jit",
      "label": "artifact",
      "description": "JIT consumes CodegenArtifact from lowering.",
      "props": {}
    },
    {
      "kind": "feeds",
      "from": "lower",
      "to": "aot",
      "label": "artifact",
      "description": "AOT consumes the same CodegenArtifact.",
      "props": {}
    },
    {
      "kind": "feeds",
      "from": "resolve",
      "to": "lsp",
      "label": "context",
      "description": "LSP uses workspace and manifest paths alongside buffer text.",
      "props": {}
    }
  ]
}

