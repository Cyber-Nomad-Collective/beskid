# -------------------------------------------------
# Base image – can be overridden per‑service
# -------------------------------------------------
FROM node:20-alpine AS base

WORKDIR /app

# Copy package files
COPY package*.json ./
RUN npm ci --only=production

# Copy source
COPY . .

# Build (if needed)
RUN npm run build

# -------------------------------------------------
# Final runtime image
# -------------------------------------------------
FROM node:20-alpine
WORKDIR /app
COPY --from=base /app ./
ENTRYPOINT ["./entrypoint.sh"]
