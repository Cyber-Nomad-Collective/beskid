  "execution_kinds": {
    "installed_host_harness": "a Rust libtest executable built from the same compiler commit runs one `--exact` test per required id against the installed candidate prefix named by BESKID_V06_QUALIFIED_PREFIX; every installed CLI invocation is proven by a `beskid-installed-invocation` line in retained stderr whose digest is the installed CLI",
    "installed_native": "the installed candidate CLI runs one `beskid test --json` target of the bundled Corelib test workspace; required ids must be a subset of its passed tests and nothing in the target may fail, skip, filter out or time out"
  },
