{
  "schema_version": 2,
  "release_series": "0.6",
  "state": "binding_required",
  "targets": [
    "x86_64-unknown-linux-gnu",
    "aarch64-apple-darwin",
    "x86_64-pc-windows-msvc"
  ],
  "normative_source": "openspec/changes/v06-release-qualification/specs/compiler--conformance--conformance-evidence-policy/spec.md",
  "policy": {
    "all_cases_mandatory": true,
    "baseline_count": 16,
    "unbound_cases_reject": true,
    "net_glue": "stretch",
    "allowed_outcome": "passed",
    "installed_prefix_only": true,
    "assertion_bindings_must_exist_in_consumed_source": true
  },
  "rust_profile": {
    "representations": [
      "i8",
      "i16",
      "i32",
      "i64",
      "u8",
      "u16",
      "u32",
      "u64",
      "f32",
      "f64",
      "bool",
      "char",
      "utf8_view",
      "byte_view",
      "unit",
      "opaque_handle",
      "native_width"
    ],
    "implementations": [
      "manual",
      "generated"
    ],
    "directions": [
      "import",
      "export"
    ],
    "required_ownership": [
      "borrowed_call",
      "owned_transfer",
      "release_exactly_once",
      "stale_generation_reject",
      "forced_gc"
    ],
    "failure_cases": [
      "invalid_utf8",
      "invalid_unicode_scalar",
      "invalid_bool",
      "null_length_bounds",
      "foreign_panic",
      "foreign_error",
      "target_width_mismatch"
    ],
    "transport": "stdio",
    "process_scheduler": "canonical_runtime"
  },
