{
	"$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git"
	},
	"files": {
		"includes": [
			"**/*.ts",
			"**/*.tsx",
			"**/*.js",
			"**/*.jsx",
			"**/*.json",
			"**/*.yaml",
			"**/*.yml",
			"**/.vscode/**/*",
			"**/index.html",
			"**/vite.config.ts",
			"!**/node_modules",
			"!**/.git",
			"!**/vendor",
			"!**/dist",
			"!**/.output",
			"!**/.turbo",
			"!**/compiler",
			"!**/.gitnexus",
			"!**/.vscode-test"
		],
		"maxSize": 10485760
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 1
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"json": {
		"formatter": {
			"enabled": true
		}
	}
}
