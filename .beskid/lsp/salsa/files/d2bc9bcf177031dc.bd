// CHECKED IN: `[FluentStep]`-annotated fluent wrapper; step contract emitted by `corelib_fluent_gen`.
/// Fluent wrapper for `Collections.Set<T>`.
/// @tier(supported)
use Beskid.Fluent;
use Collections.Set;

[FluentStep(stepName: "SetStep", innerField: "inner")]
pub type SetFluent<T> {
    [FluentInner]
    Collections.Set<T> inner,

    [FluentChain]
    pub SetFluent<T> Add(T value) => (SetFluent<T> { inner: inner.Add(value) })

    [FluentChain]
    pub SetFluent<T> Remove(T value) => (SetFluent<T> { inner: inner.Remove(value) })

    pub bool Contains(T value) => inner.Contains(value)

    [FluentTerminal]
    pub Collections.Set<T> IntoSet() => inner
}

pub SetFluent<T> FromSet<T>(Collections.Set<T> set) {
    return SetFluent<T> { inner: set };
}
