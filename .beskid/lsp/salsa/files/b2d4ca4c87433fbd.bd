// CHECKED IN: `[FluentStep]`-annotated fluent wrapper; step contract emitted by `corelib_fluent_gen`.
/// Fluent wrapper for `Collections.Map<TKey, TValue>`.
/// @tier(supported)
use Beskid.Fluent;
use Collections.Map;
use Core.Results;

[FluentStep(stepName: "MapStep", innerField: "inner")]
pub type MapFluent<TKey, TValue> {
    [FluentInner]
    Collections.Map<TKey, TValue> inner,

    [FluentChain]
    pub MapFluent<TKey, TValue> Insert(TKey key, TValue value) =>
        (MapFluent<TKey, TValue> { inner: inner.Insert(key, value) })

    [FluentChain]
    pub MapFluent<TKey, TValue> Remove(TKey key) =>
        (MapFluent<TKey, TValue> { inner: inner.Remove(key) })

    pub Result<TValue, string> Get(TKey key) => inner.Get(key)

    pub bool ContainsKey(TKey key) => inner.ContainsKey(key)

    [FluentTerminal]
    pub Collections.Map<TKey, TValue> IntoMap() => inner
}

pub MapFluent<TKey, TValue> FromMap<TKey, TValue>(Collections.Map<TKey, TValue> map) {
    return MapFluent<TKey, TValue> { inner: map };
}
