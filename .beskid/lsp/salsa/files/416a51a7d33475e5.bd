/// Fluent wrapper for `Query.QueryState<T>`.
/// @tier(supported)
use Beskid.Fluent;
use Core.Optional;
use Query.Operators;
use Query.QueryState;

[FluentStep(stepName: "QueryStep", innerField: "inner")]
pub type QueryFluent<T> {
    [FluentInner]
    Query.QueryState<T> inner,

    [FluentChain]
    pub QueryFluent<T> Where(bool predicate) =>
        (QueryFluent<T> { inner: Query.Operators.Where<T>(inner, predicate) })

    [FluentChain]
    pub QueryFluent<TOut> Select(TOut sample) =>
        (QueryFluent<TOut> { inner: Query.Operators.Select<T, TOut>(inner, sample) })

    [FluentChain]
    pub QueryFluent<T> Take(i64 count) =>
        (QueryFluent<T> { inner: Query.Operators.Take<T>(inner, count) })

    [FluentChain]
    pub QueryFluent<T> Skip(i64 count) =>
        (QueryFluent<T> { inner: Query.Operators.Skip<T>(inner, count) })

    pub Core.Optional.Option<T> First() => Query.Operators.First<T>(inner)

    pub i64 Count() => Query.Operators.Count<T>(inner)

    [FluentTerminal]
    pub Query.QueryState<T> IntoQueryState() => inner
}

pub QueryFluent<T> FromQueryState<T>(Query.QueryState<T> state) {
    return QueryFluent<T> { inner: state };
}

pub QueryFluent<T> FromArray<T>(T[] source) {
    return QueryFluent<T> { inner: Query.Operators.FromArray<T>(source) };
}
