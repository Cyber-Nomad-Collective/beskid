// Reference compiler-mod fixture: self-contained SDK-shaped contracts so rebuild
// tests can lower without registry dependencies while still emitting the same
// `(contractId, typeId, entrySymbol)` tuples as the compiler-sdk surface.

pub type CollectRequest {}
pub type CollectTargetSet {}
pub type GenerationRequest {}
pub type GeneratedSyntaxContribution {
    SyntaxContributionItem[] items,
}
pub type SyntaxContributionItem {}
pub type AnalysisRequest {}
pub type AnalysisResult {}
pub type AttributeGenerationRequest {}
pub type AttributeDeclarationSet {}
pub type FixError {}

pub contract Collector {
    CollectTargetSet Collect(CollectRequest request);
}

pub contract Generator {
    GeneratedSyntaxContribution Generate(GenerationRequest request);
}

pub contract AttributeGenerator {
    AttributeDeclarationSet Attributes(AttributeGenerationRequest request);
}

pub contract Analyzer {
    AnalysisResult Analyze(AnalysisRequest request);
}

pub contract Rewriter {
    CollectRequest Rewrite(CollectRequest sourceNode);
}

pub type SampleCollect : Collector {
    CollectTargetSet Collect(CollectRequest request) {
        return CollectTargetSet {};
    }
}

pub type SampleGenerate : Generator {
    GeneratedSyntaxContribution Generate(GenerationRequest request) {
        return GeneratedSyntaxContribution { items: [] };
    }
}

pub type SampleAttribute : AttributeGenerator {
    AttributeDeclarationSet Attributes(AttributeGenerationRequest request) {
        return AttributeDeclarationSet {};
    }
}

pub type SampleAnalyze : Analyzer {
    AnalysisResult Analyze(AnalysisRequest request) {
        return AnalysisResult {};
    }
}

pub type SampleRewrite : Rewriter {
    CollectRequest Rewrite(CollectRequest sourceNode) {
        return sourceNode;
    }
}
