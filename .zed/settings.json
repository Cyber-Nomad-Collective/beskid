{
    "file_types": {
        "Beskid": [
            "bd"
        ],
        "Beskid Manifest": [
            "bproj",
            "bws"
        ]
    },
    "tab_size": 4,
    "hard_tabs": false,
    "ensure_final_newline_on_save": true,
    "remove_trailing_whitespace_on_save": true,
    "format_on_save": "on",
    "formatter": "language_server",
    "languages": {
        "Rust": {
            "tab_size": 4,
            "hard_tabs": false
        },
        "TypeScript": {
            "tab_size": 2
        },
        "JSON": {
            "tab_size": 2
        },
        "TSX": {
            "tab_size": 2
        },
        "TOML": {
            "tab_size": 2
        },
        "Markdown": {
            "soft_wrap": "editor_width"
        }
    },
    "lsp": {
        "rust-analyzer": {
            "initialization_options": {
                "check": {
                    "command": "clippy"
                }
            }
        }
    },
    "file_scan_exclusions": [
        "**/.git",
        "**/.svn",
        "**/.hg",
        "**/.jj",
        "**/CVS",
        "**/.DS_Store",
        "**/Thumbs.db",
        "**/.classpath",
        "**/.settings",
        "**/node_modules",
        "**/target",
        "**/dist",
        "**/.next",
        "**/.turbo",
        "**/pnpm-lock.yaml"
    ]
}
