# Non-secret production Compose inputs. Copy to .env on the host and overlay
# production secrets from OpenBao. Never use these placeholder values in a
# running deployment.
SITE_IMAGE_TAG=production
TRACKER_IMAGE_TAG=production
NEXUS_IMAGE_TAG=production
PCKG_IMAGE_TAG=production
LEARN_IMAGE_TAG=production
BESKID_EDGE_NETWORK=replace-with-the-shared-host-edge-network

REGISTRY_USERNAME=replace-with-the-registry-user
REGISTRY_PASSWORD=replace-with-the-registry-password

POSTGRES_USER=beskid
POSTGRES_PASSWORD=replace-before-deploy
PCKG_DATABASE_URL=postgres://beskid:replace-before-deploy@postgres:5432/beskid
# NodeBB community linking for pckg. Set all four or none: a partial set is a
# pckg startup error. The token is the Write API bearer token of the bot user
# that opens one thread per package and posts release replies (Settings > API
# Access); the id is the "Packages" category every package thread is opened in.
# Server-to-server origin. Containers on this host cannot reach the public IP
# (no NAT hairpin), so use the NodeBB container on the shared edge network.
PCKG_NODEBB_API_URL=http://beskid-community:4567
PCKG_NODEBB_BOT_TOKEN=replace-with-the-user-bound-token-of-the-bot-user
PCKG_NODEBB_PACKAGES_CID=replace-with-the-packages-category-id
PCKG_COMMUNITY_URL=https://community.beskid-lang.org

AUTHENTIK_POSTGRES_PASSWORD=replace-with-a-database-password
AUTHENTIK_SECRET_KEY=replace-with-a-60-character-secret
AUTHENTIK_BOOTSTRAP_TOKEN=replace-with-a-bootstrap-api-token
GITHUB_CLIENT_ID=replace-with-the-authentik-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-the-authentik-github-oauth-client-secret
