# Non-secret production Compose inputs. Copy to .env on the host and overlay
# production secrets from OpenBao. Never use these placeholder values in a
# running deployment.
SITE_IMAGE_TAG=production
AUTH_IMAGE_TAG=production
TRACKER_IMAGE_TAG=production
NEXUS_IMAGE_TAG=production
PCKG_IMAGE_TAG=production
LEARN_IMAGE_TAG=production
BESKID_EDGE_NETWORK=replace-with-the-shared-host-edge-network

POSTGRES_USER=beskid
POSTGRES_PASSWORD=replace-before-deploy
PCKG_DATABASE_URL=postgres://beskid:replace-before-deploy@postgres:5432/beskid

AUTH_HUB_PUBLIC_URL=https://auth.beskid-lang.org
AUTH_HUB_SECRET=replace-with-a-32-character-secret
SESSION_SECRET=replace-with-a-32-character-secret
PCKG_SESSION_SECRET=replace-with-a-32-character-secret
PCKG_AUTH_HUB_SERVICE_TOKEN=replace-with-a-service-token
GITHUB_CLIENT_ID=replace-before-deploy
GITHUB_CLIENT_SECRET=replace-before-deploy
